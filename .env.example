DATABASE_URL="file:../data/p3h.db"
NEXT_TELEMETRY_DISABLED=1
# Set COOKIE_SECURE=true only behind organisation-controlled HTTPS.
COOKIE_SECURE=false
# For an internal HTTPS reverse proxy, set its exact external origin:
# APP_ORIGIN="https://p3h.organisation.internal"

# Optional automatic staff reminder emails. Keep disabled until configured.
EMAIL_ENABLED=false
# RESEND_API_KEY=
# EMAIL_FROM=
# APP_ORIGIN=https://your-dashboard-host.example
# NOTIFICATION_JOB_SECRET=generate-a-separate-random-secret-at-least-32-characters

# Manual programme integration - server only
P3H_SYNC_ENABLED=false
# P3H_PROGRAMME_FEED_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/p3h-programmes
# P3H_SYNC_SHARED_SECRET=YOUR_RANDOM_SHARED_SECRET_32_TO_512_CHARACTERS
