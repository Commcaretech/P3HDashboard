# Render server environment only. Never commit real connection strings or tokens.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&connection_limit=3"
COOKIE_SECURE=true
NEXT_TELEMETRY_DISABLED=1
SETUP_TOKEN="replace-with-a-random-secret-of-at-least-32-characters"
# Render supplies RENDER_EXTERNAL_URL automatically. For email, explicitly set HTTPS APP_ORIGIN to your Render URL or custom domain.
# APP_ORIGIN="https://your-custom-domain.example"

# Optional automatic staff reminder emails. Keep disabled until configured.
EMAIL_ENABLED=false
# RESEND_API_KEY=
# EMAIL_FROM=
# APP_ORIGIN=https://your-dashboard-host.example
# NOTIFICATION_JOB_SECRET=generate-a-separate-random-secret-at-least-32-characters
