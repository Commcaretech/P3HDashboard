{
  "name": "p3hdashboard",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "node scripts/ensure-db.mjs && prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "backup": "node scripts/backup.mjs",
    "test:persistence": "tsx --test tests/persistence/*.test.ts",
    "cloud:generate": "prisma generate --schema prisma/cloud/schema.prisma",
    "cloud:validate": "prisma validate --schema prisma/cloud/schema.prisma",
    "cloud:migrate": "prisma migrate deploy --schema prisma/cloud/schema.prisma",
    "cloud:build": "npm run cloud:generate && npm run build",
    "cloud:start": "npm run cloud:migrate && node scripts/cloud-start.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChanYule/P3HDashboard.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ChanYule/P3HDashboard/issues"
  },
  "homepage": "https://github.com/ChanYule/P3HDashboard#readme",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "saxes": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "uuid": "^11.1.1",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    }
  }
}
