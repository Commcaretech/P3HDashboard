generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model User {
 id String @id @default(cuid())
 username String @unique
 name String
 passwordHash String
 role String @default("Staff")
 active Boolean @default(true)
 email String? @unique
 emailNotifications Boolean @default(false)
 recipientBirthdays Boolean @default(false)
 sessions Session[]
 audits AuditLog[]
 alerts Alert[]
 grants GrantApplication[]
 cases Person[]
 allCentres Boolean @default(true)
 allowedCentres UserCentre[]
}
model UserCentre {
 userId String
 centre String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@id([userId,centre])
 @@index([centre])
}
model Session {
 id String @id
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 expiresAt DateTime
 @@index([expiresAt])
}
model Person {
 deletedAt DateTime?
 deletedBy String?
 @@index([deletedAt])
 surveyResponses SurveyResponse[]
 verifiedAliases PersonAlias[]
 id String @id @default(cuid())
 kind String
 memberId String? @unique
 name String @default("")
 contactNumber String @default("")
 alias String @default("")
 dob DateTime?
 centre String @default("")
 gender String @default("")
 race String @default("")
 workingStatus String @default("")
 preferredLanguage String @default("")
 onboardingDate DateTime?
 status String @default("Active")
 mobility String @default("")
 hearing String @default("")
 eyesight String @default("")
 dietaryPreference String @default("")
 foodAllergies String @default("")
 education String @default("")
 primaryCondition String @default("")
 tags String @default("")
 remarks String @default("")
 assignedId String?
 assigned User? @relation(fields:[assignedId],references:[id])
 rawImport Json?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 languages PersonLanguage[]
 interests PersonInterest[]
 conditions PersonCondition[]
 assessments Assessment[]
 caregiverLinks CareRelationship[] @relation("caregiver")
 recipientLinks CareRelationship[] @relation("recipient")
 grants GrantApplication[]
 alerts Alert[]
 participations Participation[]
 @@index([assignedId,status,updatedAt])
 @@index([kind,status])
 @@index([name])
 @@index([centre])
}
model CareRelationship {
 id String @id @default(cuid())
 memberId String
 recipientId String
 relationship String
 member Person @relation("caregiver",fields:[memberId],references:[id])
 recipient Person @relation("recipient",fields:[recipientId],references:[id])
 @@unique([memberId,recipientId])
 @@index([recipientId])
}
model Language {
 id String @id @default(cuid())
 name String @unique
 people PersonLanguage[]
 programmes ProgrammeLanguage[]
}
model Interest {
 id String @id @default(cuid())
 name String @unique
 people PersonInterest[]
 programmes ProgrammeInterest[]
}
model MedicalCondition {
 id String @id @default(cuid())
 name String @unique
 people PersonCondition[]
 programmes ProgrammeCondition[]
}
model PersonLanguage {
 personId String
 languageId String
 mode String @default("Spoken / understood")
 person Person @relation(fields:[personId],references:[id],onDelete:Cascade)
 language Language @relation(fields:[languageId],references:[id])
 @@id([personId,languageId])
 @@index([languageId])
}
model PersonInterest {
 personId String
 interestId String
 person Person @relation(fields:[personId],references:[id],onDelete:Cascade)
 interest Interest @relation(fields:[interestId],references:[id])
 @@id([personId,interestId])
 @@index([interestId])
}
model PersonCondition {
 personId String
 conditionId String
 notes String @default("")
 person Person @relation(fields:[personId],references:[id],onDelete:Cascade)
 condition MedicalCondition @relation(fields:[conditionId],references:[id])
 @@id([personId,conditionId])
 @@index([conditionId])
}
model Assessment {
 id String @id @default(cuid())
 personId String
 person Person @relation(fields:[personId],references:[id])
 type String
 value Float
 assessedAt DateTime?
 recordedAt DateTime @default(now())
 notes String @default("")
 @@index([personId])
}
model Programme {
 deletedAt DateTime?
 deletedBy String?
 @@index([deletedAt])
 interestTagsReviewed Boolean @default(false)
 review ProgrammeReview?
 external ExternalProgramme?
 suitabilityReviewed Boolean @default(false)
 id String @id @default(cuid())
 name String
 description String @default("")
 category String @default("")
 mobility String @default("")
 venue String @default("")
 centre String @default("")
 day String @default("")
 startTime String @default("")
 endTime String @default("")
 frequency String @default("")
 capacity Int @default(0)
 registrationStatus String @default("Open")
 status String @default("Active")
 notes String @default("")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 languages ProgrammeLanguage[]
 interests ProgrammeInterest[]
 conditions ProgrammeCondition[]
 participations Participation[]
 @@index([status,centre])
}
model ProgrammeLanguage {
 programmeId String
 languageId String
 programme Programme @relation(fields:[programmeId],references:[id],onDelete:Cascade)
 language Language @relation(fields:[languageId],references:[id])
 @@id([programmeId,languageId])
}
model ProgrammeInterest {
 programmeId String
 interestId String
 programme Programme @relation(fields:[programmeId],references:[id],onDelete:Cascade)
 interest Interest @relation(fields:[interestId],references:[id])
 @@id([programmeId,interestId])
}
model ProgrammeCondition {
 programmeId String
 conditionId String
 programme Programme @relation(fields:[programmeId],references:[id],onDelete:Cascade)
 condition MedicalCondition @relation(fields:[conditionId],references:[id])
 @@id([programmeId,conditionId])
}
model Participation {
 id String @id @default(cuid())
 personId String
 programmeId String
 person Person @relation(fields:[personId],references:[id])
 programme Programme @relation(fields:[programmeId],references:[id])
 status String @default("Registered")
 @@unique([personId,programmeId])
}
model SupportScheme {
 id String @id @default(cuid())
 name String @unique
 applications GrantApplication[]
}
model GrantApplication {
 deletedAt DateTime?
 deletedBy String?
 @@index([deletedAt])
 id String @id @default(cuid())
 schemeId String
 scheme SupportScheme @relation(fields:[schemeId],references:[id])
 personId String
 person Person @relation(fields:[personId],references:[id])
 followUpFrequency String @default("Automatic")
 followUpDays Int?
 followUpMonths Int?
 recurring Boolean @default(false)
 resolvedAt DateTime?
 overrideReason String @default("")
 followUps FollowUp[]
 applicationDate DateTime?
 submissionDate DateTime?
 approvalDate DateTime?
 expiryDate DateTime?
 nextReviewDate DateTime?
 status String @default("Not Applied")
 amount Float?
 notes String @default("")
 assignedId String?
 assigned User? @relation(fields:[assignedId],references:[id])
 updatedAt DateTime @updatedAt
 alerts Alert[]
 @@index([status,nextReviewDate])
 @@index([personId])
}
model Alert {
 id String @id @default(cuid())
 autoDismissed Boolean @default(false)
 activeFollowUpKey String? @unique
 sourceKey String? @unique
 title String
 personId String?
 person Person? @relation(fields:[personId],references:[id])
 grantId String?
 grant GrantApplication? @relation(fields:[grantId],references:[id])
 type String
 dueDate DateTime
 snoozedUntil DateTime?
 priority String @default("Normal")
 assignedId String?
 assigned User? @relation(fields:[assignedId],references:[id])
 status String @default("Pending")
 notes String @default("")
 @@index([assignedId,status])
 @@index([status,snoozedUntil])
 @@index([status,dueDate])
}
model AuditLog {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId],references:[id])
 action String
 entityType String
 entityId String
 timestamp DateTime @default(now())
 changes Json
 @@index([entityType,entityId,timestamp])
}
model ImportBatch {
 id String @id @default(cuid())
 filename String
 createdCount Int @default(0)
 updatedCount Int @default(0)
 skippedCount Int @default(0)
 errorCount Int @default(0)
 userId String
 createdAt DateTime @default(now())
 rows ImportRow[]
}
model ImportRow {
 id String @id @default(cuid())
 batchId String
 batch ImportBatch @relation(fields:[batchId],references:[id])
 rowNumber Int
 action String
 memberId String
 raw Json
 @@index([batchId])
}
model LoginAttempt {
 username String @id
 failures Int @default(0)
 lockedUntil DateTime?
}

model FollowUp {
 id String @id @default(cuid())
 alertId String @unique
 grantId String
 grant GrantApplication @relation(fields:[grantId],references:[id])
 completedBy String
 completedAt DateTime
 outcome String
 notes String @default("")
 resolved Boolean @default(false)
 nextDate DateTime?
 @@index([grantId,completedAt])
}
model NotificationDelivery {
 id String @id @default(cuid())
 notificationKey String @unique
 userId String
 type String @default("Daily digest")
 scheduledDate String
 status String @default("Pending")
 payload Json?
 reminderIds Json?
 providerMessageId String?
 lastAttempt DateTime?
 attempts Int @default(0)
 failureReason String?
 leaseUntil DateTime?
 leaseToken String?
 createdAt DateTime @default(now())
 @@index([status,scheduledDate])
}

model ExternalProgramme {
 programmeType String @default("")
 reviewFingerprint String @default("")
 eligibilityRulesVersion Int @default(0)
 groupingStatus String @default("Unverified")
 id String @id @default(cuid())
 programmeId String @unique
 programme Programme @relation(fields:[programmeId],references:[id])
 source String
 sourceKey String
 centreId String
 sourceStatus String @default("")
 ownership String @default("Imported")
 missing Boolean @default(false)
 sourceUpdatedAt DateTime?
 lastSeenAt DateTime
 lastSyncAt DateTime
 fingerprint String
 occurrences ExternalOccurrence[]
 @@unique([source,sourceKey])
}
model ExternalOccurrence {
 visibilityKnown Boolean @default(false)
 eligibilityStatus String @default("unverified")
 schedulingStatus String @default("not_checked")
 recommendationEligible Boolean @default(false)
 reasonCodes Json @default("[]")
 sourceActivityName String @default("")
 independentSession Boolean @default(false)
 timetableVisible Boolean @default(false)
 calendarVisible Boolean @default(false)
 id String @id @default(cuid())
 externalId String
 external ExternalProgramme @relation(fields:[externalId],references:[id])
 sourceKey String
 sourceRecordIds Json
 date String?
 day String @default("")
 startTime String @default("")
 endTime String @default("")
 venue String @default("")
 status String @default("")
 recurrence String @default("")
 missing Boolean @default(false)
 sourceUpdatedAt DateTime?
 @@unique([externalId,sourceKey])
 @@index([date,status])
}
model ProgrammeSyncRun {
 diagnostics Json?
 id String @id @default(cuid())
 userId String?
 scope Json
 startedAt DateTime @default(now())
 finishedAt DateTime?
 status String @default("Running")
 created Int @default(0)
 updated Int @default(0)
 unchanged Int @default(0)
 skipped Int @default(0)
 errors Int @default(0)
 errorSummary String @default("")
 @@index([startedAt])
}
model ProgrammeSyncLock {
 id String @id
 token String
 expiresAt DateTime
}

model ProgrammeReview {
 id String @id @default(cuid())
 programmeId String @unique
 programme Programme @relation(fields:[programmeId],references:[id])
 status String @default("Pending Review")
 audience String @default("")
 languageAssessment String @default("Not Assessed")
 interestAssessment String @default("Not Assessed")
 mobilityAssessment String @default("Not Assessed")
 conditionAssessment String @default("Not Assessed")
 accessibility String @default("")
 intensity String @default("Not Assessed")
 staffNotes String @default("")
 issues Json
 sourceFingerprint String @default("")
 reviewedBy String?
 reviewedByName String @default("")
 reviewedAt DateTime?
 updatedAt DateTime @updatedAt
 @@index([status])
}

model MaintenanceState {
 id String @id
 lastCompletedDate String @default("")
 lastCompletedAt DateTime?
 leaseUntil DateTime?
 leaseToken String?
}

model SurveyImportBatch {
 id String @id @default(cuid())
 filename String
 language String
 centre String
 uploadedBy String
 createdAt DateTime @default(now())
 status String @default("Completed")
 summary Json
 responses SurveyResponse[]
 @@index([centre,createdAt])
}
model SurveyResponse {
 deletedAt DateTime?
 deletedBy String?
 @@index([deletedAt])
 id String @id @default(cuid())
 batchId String
 batch SurveyImportBatch @relation(fields:[batchId],references:[id])
 sourceKey String @unique
 contentHash String
 sourceResponseId String @default("")
 importMode String @default("Legacy")
 rowNumber Int
 centre String
 language String
 submittedName String
 cleanedName String
 correctedName String?
 timestampText String
 surveyDate DateTime?
 dobText String @default("")
 dob DateTime?
 phaseText String @default("")
 phase String @default("Needs Review")
 personId String?
 person Person? @relation(fields:[personId],references:[id])
 confirmedMemberId String?
 matchStatus String @default("Unmatched")
 rawAnswers Json
 answers Json
 method String
 warnings Json
 physical Float?
 psychological Float?
 social Float?
 environment Float?
 overall Float?
 zbi Int?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 reviews SurveyIdentityReview[]
 identityStage SurveyIdentityStage?
 @@index([centre,matchStatus,surveyDate])
 @@index([personId,method,surveyDate])
 @@index([confirmedMemberId,surveyDate])
 @@index([sourceResponseId])
}
model SurveyIdentityStage {
 responseId String @id
 response SurveyResponse @relation(fields:[responseId],references:[id])
 submittedName String
 cleanedName String
 correctedName String?
 dobText String
 dob DateTime?
 nameHistory Json
}
model SurveyIdentityReview {
 id String @id @default(cuid())
 responseId String
 response SurveyResponse @relation(fields:[responseId],references:[id])
 personId String?
 memberId String?
 action String
 method String @default("Staff confirmation")
 reviewedBy String
 reviewedAt DateTime @default(now())
 notes String @default("")
 @@index([responseId,reviewedAt])
}
model PersonAlias {
 id String @id @default(cuid())
 personId String
 person Person @relation(fields:[personId],references:[id])
 text String
 normalized String
 verified Boolean @default(true)
 verifiedBy String
 verifiedAt DateTime @default(now())
 source String @default("Staff verification")
 createdAt DateTime @default(now())
 @@unique([personId,normalized])
 @@index([normalized,verified])
}
